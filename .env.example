# Copy to .env and change every value before exposing this app to the internet.
APP_MODE=multi
APP_DOMAIN=shorts.example.com
APP_BASE_URL=https://api.example.com
# Public frontend URL when it is hosted separately (Vercel). Leave empty for
# same-origin deployments; APP_BASE_URL is used as the fallback.
FRONTEND_BASE_URL=
# Exact URL registered in each member's Google OAuth web client.
OAUTH_REDIRECT_URI=https://api.example.com/api/auth/callback
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-long-random-string
# Required for everyone after the first account.
REGISTRATION_INVITE_CODE=replace-with-a-private-invite
MAX_USERS=4
COOKIE_SECURE=true
# Use "none" only when the frontend and API are on different sites (Vercel +
# EC2); it requires COOKIE_SECURE=true and HTTPS.
COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
DEFAULT_PRIVACY=private

# Docker Compose PostgreSQL. Change the password before deploying.
POSTGRES_DB=shorts
POSTGRES_USER=shorts
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+psycopg://shorts:replace-with-a-strong-db-password@db:5432/shorts

# Keep media on the Docker volume. Retention settings are reserved for now
# (the backend does not enforce them yet); 0 = keep.
DATA_DIR=/data
WORKER_CONCURRENCY=2
MEDIA_RETENTION_DAYS=14
JOB_SOURCE_RETENTION_DAYS=7

# Optional model used when a member leaves the AI model field blank.
# Leave empty to send OmniRoute's "auto" router for blank models.
LLM_DEFAULT_MODEL=

# YouTube access from a datacenter/cloud IP. Export a complete Netscape
# cookies.txt from a signed-in browser (it must include LOGIN_INFO and
# SID/__Secure-1PSID; preferably a dedicated account, not your main Google
# account). On Windows, scripts/refresh-youtube-cookies.ps1 exports, tests and
# installs it. A file at $DATA_DIR/secrets/youtube-cookies.txt overrides this
# read-only mount. YTDLP_PROXY can point yt-dlp at an HTTP/SOCKS proxy instead
# of, or in addition to, cookies.
# YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080

# Live capture. Live links always use chat-spike detection; these knobs bound
# the scan, padding and total recording time.
# How long to keep watching chat for a next spike.
LIVE_CHAT_SCAN_SECONDS=900
# Live video cannot be rewound; record only this long after each spike.
LIVE_SPIKE_PAD_SECONDS=60
LIVE_MAX_CAPTURE_SECONDS=1800
# Auto-pick the strongest spike if nobody chooses within this many seconds.
LIVE_PICK_TIMEOUT_SECONDS=300
# Fail a recording whose ffmpeg writes no data for this many seconds.
LIVE_RECORD_STALL_SECONDS=120
