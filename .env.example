# Copy to .env and change every value before exposing this app to the internet.
APP_MODE=multi
APP_DOMAIN=shorts.example.com
APP_BASE_URL=https://shorts.example.com
# Exact URL registered in each member's Google OAuth web client.
OAUTH_REDIRECT_URI=https://shorts.example.com/api/auth/callback
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-long-random-string
# Required for everyone after the first account.
REGISTRATION_INVITE_CODE=replace-with-a-private-invite
MAX_USERS=4
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
DEFAULT_PRIVACY=private

# Docker Compose PostgreSQL. Change the password before deploying.
POSTGRES_DB=shorts
POSTGRES_USER=shorts
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+psycopg://shorts:replace-with-a-strong-db-password@db:5432/shorts

# Keep media on the Docker volume. Retention settings are reserved for now
# (the backend does not enforce them yet); 0 = keep.
DATA_DIR=/data
WORKER_CONCURRENCY=2
MEDIA_RETENTION_DAYS=14
JOB_SOURCE_RETENTION_DAYS=7

# Live capture. Live links always use chat-spike detection; these knobs bound
# the scan, padding and total recording time.
LIVE_CHAT_SCAN_SECONDS=300
LIVE_SPIKE_PAD_SECONDS=300
LIVE_MAX_CAPTURE_SECONDS=1800
# Fail a recording whose ffmpeg writes no data for this many seconds.
LIVE_RECORD_STALL_SECONDS=120
