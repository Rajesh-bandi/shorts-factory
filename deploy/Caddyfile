# API-only host. The frontend is served by Vercel; this origin keeps the API,
# media files and health check on the EC2 instance.
{$APP_DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /media/* {
        reverse_proxy backend:8000
    }
    handle /healthz {
        reverse_proxy backend:8000
    }
    handle {
        respond "Shorts Factory API" 200
    }
}

# OmniRoute dashboard. Reachable without an SSH tunnel, but protected by HTTP
# basic auth in addition to OmniRoute's own login. The hash lives in the
# server's .env, never in this public repo.
omniroute.{$APP_DOMAIN} {
    encode zstd gzip
    basic_auth {
        rajesh {$OMNIROUTE_BASIC_AUTH_HASH}
    }
    reverse_proxy omniroute:20128
}
