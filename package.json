{
  "name": "shorts-factory",
  "version": "1.3.0",
  "description": "Turn long YouTube videos into vertical Shorts — local desktop studio.",
  "author": "Shorts Factory",
  "desktopName": "shorts-factory.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rajesh-bandi/shorts-factory.git"
  },
  "main": "electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "backend:dev": "bash -c 'if [ -x .venv/bin/python ]; then .venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8787; else python3 -m uvicorn backend.main:app --host 127.0.0.1 --port 8787; fi'",
    "prepare:desktop": "node scripts/build-desktop.js",
    "dist": "npm run prepare:desktop && electron-builder --linux AppImage --publish never",
    "dist:dir": "npm run prepare:desktop && electron-builder --dir --publish never",
    "dist:win": "npm run prepare:desktop && electron-builder --win nsis --publish never",
    "dist:mac": "npm run prepare:desktop && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "com.shortsfactory.desktop",
    "productName": "Shorts Factory",
    "copyright": "Shorts Factory",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "build/bin",
        "to": "bin"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Shorts-Factory-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Shorts-Factory-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shorts Factory",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "artifactName": "Shorts-Factory-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
